    "version": "0.2.0",
    "configurations": [

        {
            "name": "ZenStream",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "cwd": "${workspaceFolder}/zenstream",
            "args": [
                "run", "main.py", "--server.runOnSave", "true",
                "--server.headless", "true"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "subProcess": false
        }

    ]
}